# Arbitrage Finder Configuration
# Copy this file to .env and customize as needed

# Profit Settings
MIN_PROFIT_PCT=1.0
HIGH_PROFIT_THRESHOLD=3.0

# Exchange Settings
MAX_RETRIES=3
RETRY_DELAY=1.0
RATE_LIMIT_PER_SECOND=10

# Monitoring Settings
SCAN_INTERVAL=10
AUTO_SCAN_ENABLED=false

# Fee Settings
DEFAULT_TRADING_FEE=0.002
WITHDRAWAL_FEE_PCT=0.001

# Execution Settings
MAX_EXECUTION_TIME=60.0
MIN_LIQUIDITY=10000.0

# Logging
LOG_LEVEL=INFO
LOG_TO_FILE=true
